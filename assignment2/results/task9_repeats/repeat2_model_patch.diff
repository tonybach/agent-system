+++ b/packages/metrics/lib/observeApiError.ts
@@ -0,0 +1,23 @@
+type MetricsApiStatusTypes = '4xx' | '5xx' | 'failure';
+
+type MetricObserver = (status: MetricsApiStatusTypes) => void;
+
+function observeApiError(error: unknown, metricObserver: MetricObserver): void {
+    if (!error) {
+        metricObserver('failure');
+        return;
+    }
+
+    const { status } = error as { status?: number };
+
+    if (status != null && status >= 500) {
+        metricObserver('5xx');
+    } else if (status != null && status >= 400) {
+        metricObserver('4xx');
+    } else {
+        metricObserver('failure');
+    }
+}
+
+export { observeApiError, MetricsApiStatusTypes };
+export default observeApiError;
